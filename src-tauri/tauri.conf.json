{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reimbursement Manager",
  "version": "1.1.0",
  "identifier": "com.reimburse.manager",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Reimbursement Manager",
        "width": 1100,
        "height": 750,
        "minWidth": 820,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "resources/": "resources/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
